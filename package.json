	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@types/bun": "^1.3.12",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"drizzle-orm": "1.0.0-beta.20-afec359",
		"typescript": "^6.0.2",
		"vite": "^8.0.8",
		"vitest": "^4.1.0",
		"zod": "^4.3.6"
	}
